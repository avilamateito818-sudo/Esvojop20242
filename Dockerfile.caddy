# ═══════════════════════════════════════════════════════
# ESVOJOP 2026 · Alternativa 2: Docker con Caddy Server
# Servidor web moderno con soporte nativo HTTP/2, HTTP/3 y HTTPS automático
# ═══════════════════════════════════════════════════════
FROM caddy:2.8-alpine

LABEL maintainer="ESVOJOP Club de Voleibol"
LABEL version="2026.2-caddy"
LABEL description="Contenedor Caddy ultra-rápido y aislado para ESVOJOP"

# Copiar archivo de configuración Caddyfile
COPY Caddyfile /etc/caddy/Caddyfile

# Copiar únicamente activos web públicos al directorio de Caddy
WORKDIR /usr/share/caddy
COPY *.html robots.txt ./
COPY css ./css
COPY js ./js
COPY img ./img

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
