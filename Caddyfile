:80 {
    root * /usr/share/caddy
    encode gzip zstd

    @blocked {
        path */.* *Dockerfile* *docker-compose* *nginx.conf *Caddyfile *.bat
    }
    respond @blocked 403

    @static {
        path *.css *.js *.jpg *.jpeg *.gif *.png *.ico *.svg *.woff *.woff2
    }
    header @static Cache-Control "public, max-age=604800, must-revalidate"

    @html {
        path / *.html
    }
    header @html Cache-Control "no-cache, must-revalidate"

    # Enrutamiento de páginas estáticas
    try_files {path} {path}/ /index.html
    file_server

    # Cabeceras de seguridad para producción en dominio
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Content-Security-Policy "frame-ancestors 'none';"
    }
}
